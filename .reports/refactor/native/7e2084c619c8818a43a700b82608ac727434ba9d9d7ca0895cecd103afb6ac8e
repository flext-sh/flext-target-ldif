        Args:\n                runtime_sink: LDIF runtime sink handling record writes.\n                target: Singer target owning the sink.\n                stream_name: Name of the Singer stream.\n                schema: Singer schema for the stream.\n                key_properties: Singer key properties for the stream.\n\n            Returns:\n                The adapter sink bound to the runtime sink.\n\n            \"\"\"\n            schema_dict = u.json_dict_adapter().validate_python(schema)\n            service_sink = cls(\n                target=target,\n                stream_name=stream_name,\n                schema=schema_dict,\n                key_properties=key_properties,\n            )\n            service_sink._runtime_sink = runtime_sink\n            return service_sink\n\n        @override\n        def process_batch(self, context: t.JsonMapping) -> None:\n            \"\"\"Singer batch hook is handled by the LDIF runtime sink.\"\"\"\n            self._runtime_sink.process_batch(u.normalize_to_json_mapping(context))\n\n        @override\n        def process_record(self, record: t.JsonMapping, context: t.JsonMapping) -> None:\n            \"\"\"Delegate Singer record handling to the LDIF runtime sink.\"\"\"\n            self._runtime_sink.process_record(\n                u.normalize_to_json_mapping(record),\n                u.normalize_to_json_mapping(context),\n            )\n\n    @classmethod\n    def create_sink(\n        cls,\n        *,\n        stream_name: str,\n        schema: t.JsonMapping,\n        target_config: t.JsonMapping,\n    ) -> p.Meltano.SingerDrainSink:\n        \"\"\"Create the LDIF runtime sink for the service facade.\n\n        Args:\n            stream_name: Name of the Singer stream to drain.\n            schema: Singer schema for the stream.\n            target_config: Flat target settings payload.\n\n        Returns:\n            The service-level Singer sink for the stream.\n\n        \"\"\"\n        normalized_target_config = u.normalize_to_json_mapping(target_config)\n        normalized_schema = cls.normalize_schema(schema)\n        runtime_sink = FlextTargetLdifSink(\n            target_config=normalized_target_config,\n            stream_name=stream_name,\n            schema=normalized_schema,\n        )\n        return cls.Sink.create(\n            runtime_sink=runtime_sink,\n            target=cls.Target(\n                config=u.json_dict_adapter().validate_python(normalized_target_config),\n                validate_config=False,\n            ),\n            stream_name=stream_name,\n            schema=u.json_dict_adapter().validate_python(normalized_schema),\n            key_properties=[],\n        )\n\n    @staticmethod\n    def normalize_schema(source: t.JsonMapping) -> MutableMapping[str, t.JsonValue]:\n        \"\"\"Normalize a flat Singer schema to the LDIF runtime contract.\n\n        Args:\n            source: Flat Singer schema mapping to normalize.\n\n        Returns:\n            The schema values normalized to the runtime payload types.\n\n        \"\"\"\n        return {\n            key: (str(value) if isinstance(value, Path) else value)\n            for key, value in source.items()\n        }\n\n\n__all__: list[str] = [\"FlextTargetLdifServiceRuntime\"]\n","range":{"byteOffset":{"start":0,"end":4424},"start":{"line":0,"column":0},"end":{"line":133,"column":0}}}]},"transformed":{}},"ruleId":"import-header--foreign-origin--flext_target_ldif--statement","severity":"hint","note":null,"message":"Outside the families, `flext_target_ldif` binds every letter from its own root, never from another package."}
{"text":"from flext_meltano import u","range":{"byteOffset":{"start":251,"end":278},"start":{"line":11,"column":0},"end":{"line":11,"column":27}},"file":"src/flext_target_ldif/sink.py","lines":"from flext_meltano import u","charCount":{"leading":0,"trailing":0},"replacement":"","replacementOffsets":{"start":251,"end":278},"language":"Python","metaVariables":{"single":{},"multi":{"secondary":[{"text":"flext_meltano","range":{"byteOffset":{"start":256,"end":269},"start":{"line":11,"column":5},"end":{"line":11,"column":18}}},{"text":"u","range":{"byteOffset":{"start":277,"end":278},"start":{"line":11,"column":26},"end":{"line":11,"column":27}}},{"text":"\"\"\"LDIF runtime sink for the target-ldif Singer target.\n\nCopyright (c) 2026 FLEXT Team. All rights reserved.\nSPDX-License-Identifier: MIT\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom collections.abc import Mapping, Sequence\nfrom pathlib import Path\n\nfrom flext_meltano import u\n\nfrom flext_target_ldif import FlextTargetLdifWriter, c, p, t\n\n\nclass FlextTargetLdifSink:\n    \"\"\"Singer sink writing stream records to one LDIF file per stream.\"\"\"\n\n    logger: p.Logger = u.fetch_logger(__name__)\n\n    def __init__(\n        self,\n        target_config: t.JsonMapping,\n        stream_name: str,\n        schema: t.JsonMapping,\n        key_properties: Sequence[str] | None = None,\n    ) -> None:\n        \"\"\"Initialize the LDIF sink.\n\n        Args:\n            target_config: Merged target configuration mapping.\n            stream_name: Name of the Singer stream this sink drains.\n            schema: Singer schema for the stream.\n            key_properties: Singer key properties for the stream.\n\n        \"\"\"\n        self._config = target_config\n        self.stream_name = stream_name\n        self.schema = schema\n        self.key_properties = key_properties or []\n        self._ldif_writer: FlextTargetLdifWriter | None = None\n        self._output_file: Path | None = None\n\n    @property\n    def ldif_writer(self) -> FlextTargetLdifWriter:\n        \"\"\"The LDIF writer bound to this sink.\"\"\"\n        return self._resolve_ldif_writer()\n\n    def clean_up(self) -> None:\n        \"\"\"Clean up resources when sink is finished.\"\"\"\n        if self._ldif_writer:\n            result: p.Result[bool] = self._ldif_writer.close()\n            if not result.success:\n                self.logger.error(\n                    \"Failed to close LDIF writer\",\n                    error=result.error or \"\",\n                )\n            else:\n                self.logger.info(\n                    \"LDIF file written\",\n                    output_file=str(self._output_file),\n                )\n\n    def process_batch(self, context: t.JsonMapping) -> None:\n        \"\"\"Process a batch of records.\"\"\"\n        if context:\n            context_dict = u.json_dict_adapter().validate_python(context)\n            self.logger.debug(\"Processing LDIF batch\", context=context_dict)\n        self._resolve_ldif_writer()\n\n    def process_record(\n        self,\n        record: t.JsonMapping,\n        context: t.JsonMapping,\n    ) -> None:\n        \"\"\"Process a single record and write to LDIF.\n\n        Args:\n            record: Singer record payload to write.\n            context: Singer record context metadata.\n\n        Raises:\n            RuntimeError: If the LDIF writer rejects the record.\n\n        \"\"\"\n        if context:\n            context_dict = u.json_dict_adapter().validate_python(context)\n            self.logger.debug(\"Processing LDIF record\", context=context_dict)\n        ldif_writer = self._resolve_ldif_writer()\n        result: p.Result[bool] = ldif_writer.write_record(record)\n        if not result.success:\n            msg: str = f\"Failed to write LDIF record: {result.error}\"\n            raise RuntimeError(msg)\n\n    def _resolve_ldif_writer(self) -> FlextTargetLdifWriter:\n        \"\"\"Resolve the LDIF writer for this sink, creating it on first use.\n\n        Returns:\n            The LDIF writer configured from the target configuration.\n\n        \"\"\"\n        if self._ldif_writer is None:\n            output_file = self._resolve_output_file()\n            raw_ldif_options = self._config.get(\"ldif_options\", {})\n            ldif_options: t.JsonMapping = {}\n            if isinstance(raw_ldif_options, Mapping):\n                ldif_options = u.json_mapping_adapter().validate_python(\n                    raw_ldif_options,\n                )\n            raw_dn_template = self._config.get(\"dn_template\")\n            dn_template: str | None = (\n                raw_dn_template if isinstance(raw_dn_template, str) else None\n            )\n            raw_attribute_mapping = self._config.get(\"attribute_mapping\", {})\n            attribute_mapping: Mapping[str, str] = {}\n            if isinstance(raw_attribute_mapping, Mapping):\n                attribute_mapping = {\n                    key: value\n                    for key, value in raw_attribute_mapping.items()\n                    if isinstance(value, str)\n                }\n            self._ldif_writer = FlextTargetLdifWriter(\n                output_file=output_file,\n                ldif_options=ldif_options,\n                dn_template=dn_template,\n                attribute_mapping=attribute_mapping,\n                schema=self.schema,\n            )\n        return self._ldif_writer\n\n    def _resolve_output_file(self) -> Path:\n        \"\"\"Resolve the output file path for this stream.\n\n        Returns:\n            The output file path derived from the configured output\n            directory and sanitized stream name.\n\n        \"\"\"\n        if self._output_file is None:\n            output_path_raw = self._config.get(\n                \"output_path\",\n                c.TargetLdif.DEFAULT_OUTPUT_PATH,\n            )\n            output_path_str = (\n                output_path_raw\n                if isinstance(output_path_raw, str)\n                else c.TargetLdif.DEFAULT_OUTPUT_PATH\n            )\n            output_path = Path(output_path_str)\n            safe_name = \"\".join(\n                ch for ch in self.stream_name if ch.isalnum() or ch in \"-_\"\n            ).strip()\n            if not safe_name:\n                safe_name = c.ProcessingMode.STREAM\n            filename = f\"{safe_name}.ldif\"\n            self._output_file = output_path / filename\n        return self._output_file\n\n\n__all__: list[str] = [\"FlextTargetLdifSink\"]\n","range":{"byteOffset":{"start":0,"end":5667},"start":{"line":0,"column":0},"end":{"line":161,"column":0}}}]},"transformed":{}},"ruleId":"import-header--foreign-origin--flext_target_ldif--statement","severity":"hint","note":null,"message":"Outside the families, `flext_target_ldif` binds every letter from its own root, never from another package."}
